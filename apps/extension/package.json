{
  "name": "extension",
  "displayName": "Docmrk Chrome extension",
  "version": "0.0.1",
  "description": "Docmrk",
  "author": "@jsummersmuir",
  "packageManager": "pnpm@7.2.1",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.6.2",
    "@plasmohq/storage": "^1.10.0",
    "@supabase/supabase-js": "^2.43.4",
    "plasmo": "^0.87.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "ui": "*"
  },
  "devDependencies": {
    "@plasmohq/prettier-plugin-sort-imports": "3.6.4",
    "@types/chrome": "0.0.237",
    "@types/react": "18.2.7",
    "@types/react-dom": "18.2.4",
    "autoprefixer": "^10.4.19",
    "esbuild": "0.19.12",
    "jsdom": "26.1.0",
    "postcss": "^8.4.38",
    "postcss-import": "^15.1.0",
    "prettier": "2.8.8",
    "tailwindconfig": "*",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.0.4"
  },
  "manifest": {
    "permissions": [
      "storage",
      "identity"
    ],
    "host_permissions": [
      "$PLASMO_PUBLIC_SUPABASE_URL/*"
    ],
    "key": "$CRX_KEY"
  }
}
